{
  "name": "@keplen/rohlik-mcp",
  "version": "1.0.0",
  "type": "module",
  "description": "Extended MCP server for Rohlik.cz — JSON outputs, Maia AI assistant integration, allergen checking",
  "keywords": [
    "mcp",
    "rohlik",
    "grocery",
    "shopping",
    "api"
  ],
  "author": "Zbynek Poskocil (fork of @tomaspavlin/rohlik-mcp)",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": "https://github.com/Keplen/rohlik-mcp",
  "bugs": {
    "url": "https://github.com/Keplen/rohlik-mcp/issues"
  },
  "homepage": "https://github.com/Keplen/rohlik-mcp#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector -e ROHLIK_USERNAME=your-email@example.com -e ROHLIK_PASSWORD=your-password node dist/index.js",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate-api": "tsc && node dist/tests/validate-api.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "node-fetch": "^3.3.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  }
}
